[Unit]
Description=Hardrive University Mount

[Mount]
What=/dev/disk/by-uuid/3a148e9a-55de-416c-bb6d-98a0d42f53a5
Where=/var/home/ayush/Documents/University
Type=btrfs
Options=defaults,rw,nofail,ssd,noatime,compress=zstd:3,space_cache=v2,discard=async,subvol=@university

[Install]
WantedBy=multi-user.target
